# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# Firebase Storage bucket（選填）：僅在「系統設定 → 省錢專區 → 學生證件照儲存位置」
# 改選「Firebase Storage」時才需要；證件照預設存 Firestore，不填也能運作。
# 注意：2026/02/03 起 Cloud Storage for Firebase 一律要求綁定 Blaze 方案（免費額度內帳單仍為 $0），
# 且免費額度只存在於 us-central1／us-east1／us-west1 三個美國區域。
# 要建立時請到 Firebase Console → Storage → Get started，新專案名稱為 your_project.firebasestorage.app。
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# 選填：Google Identity Services 用的 Web client ID（Firebase 的 Google 登入同一組）。
# 設定後，已授權過的使用者登入不再跳彈出視窗；未設定則維持彈窗登入。
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Session (至少 32 字元隨機字串，可用 openssl rand -base64 32 產生)
# 注意：若曾在本機明文 .env 中存在過，視為已暴露，請輪換並同步更新部署平台的環境變數
SESSION_SECRET=your_session_secret_min_32_chars

# TOTP 密鑰靜態加密（選填，建議正式環境設定）
# 未設定時由 SESSION_SECRET 以 HKDF 派生金鑰；兩者其一即可。
# 若要獨立輪替而不動 SESSION_SECRET，請設定 32 bytes 的 base64／base64url 金鑰：
#   openssl rand -base64 32
# 注意：更換金鑰後，舊 TOTP 密文無法解密，使用者需重新產生驗證碼APP密鑰。
# TOTP_ENCRYPTION_KEY=

# 模組專屬密鑰根金鑰（選填，建議正式環境設定）
# 未設定時由 SESSION_SECRET 派生；設定後可獨立輪替，不必動 SESSION_SECRET。
# 32 bytes base64：openssl rand -base64 32
# MODULE_SECRET_ROOT=

# 僅在「可信反向代理／平台會覆寫 forwarding header」時設 true。
# - Vercel：自動設定 VERCEL=1，不需額外設定
# - Firebase App Hosting：必須設 true（平台不自動設定，不設的話用戶 IP 會變成空字串，rate limiting 失效）
# - 直接 next start 暴露時請維持不設：此時 x-real-ip / x-forwarded-for 可被客戶端偽造，程式不會採信。
# TRUST_PROXY=true

# 跨實例 rate limit（選填）
# 未設定時各實例分開計數；本機或單實例部署足夠。
# 多實例／serverless 要共用計數時，填 Upstash Redis REST 的網址與 token。
# 未設定或 Upstash 故障時會自動退回進程內計數，不會讓全站不可用。
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 初始管理員建立開關：僅首次建管時設 true，建完請移除或設 false
ALLOW_BOOTSTRAP_ADMIN=false

# Firebase Admin SDK 服務帳號金鑰（Firebase Console → 專案設定 → 服務帳號 → 產生新的私鑰，整段 JSON 字串）
# - Vercel 等非 GCP 平台：必填
# - Firebase App Hosting：可省略（自動使用內建服務帳號，Application Default Credentials）
# 安全提醒：
# 1) 勿將實際金鑰提交進 git；機密請存於部署平台的環境變數（Vercel / Firebase Console）
# 2) 若私鑰曾在任何可分享路徑以明文存在過，請到 Firebase Console 輪換（產生新私鑰並刪除舊私鑰）
FIREBASE_SERVICE_ACCOUNT_KEY=

# SMTP 寄信（忘記密碼信件）；未設定時忘記密碼功能會回 503
#
# 【學校 Google Workspace 專用信箱設定步驟】
# 1) 請管理員建立專用信箱（如 noreply@school.edu.tw）並指派 Gmail 授權
#    ※ 群組／通訊群組信箱無法用 SMTP 登入，必須是有 Gmail 的使用者帳號
# 2) 以該信箱登入 myaccount.google.com → 安全性 → 兩步驟驗證 → 開啟
# 3) 開啟兩步驟驗證後到 myaccount.google.com/apppasswords 建立「應用程式密碼」（16 碼）
#    ※ 若該頁面不存在，代表管理員封鎖了應用程式密碼，需改用 OAuth2 或校內 SMTP relay
# 4) 應用程式密碼填入 SMTP_PASS（不可用一般登入密碼：Google 已於 2025/03 停用基本驗證）
# 5) 實際值請填在 .env.local（本機）或部署平台的環境變數，切勿寫進本檔
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# 465 設 true；587（STARTTLS）設 false
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 寄件者顯示名稱與寄件地址；寄件地址須為 SMTP_USER 本身或其別名
# 例：數位校園工具箱 <noreply@school.edu.tw>
SMTP_FROM=

# 站台對外網址（產生信件中的重設連結用）
# 正式環境務必設定：未設定時改用請求來源，Host 遭偽造可能使連結指向攻擊者網域
APP_BASE_URL=

# 模組市集（主程式讀取外部 index.json 的來源）
# 只接受 https（開發環境可用 http://localhost）
MODULE_MARKET_URL=
MODULE_MARKET_INDEX_URL=
# 模組市集正式安裝（production）使用的 GitHub 服務帳號 token
# 權限：目標 fork repo 的 Contents: Read and write
MODULE_MARKET_GITHUB_TOKEN=
# 目標 fork repo，格式 owner/repo
# - Vercel：可省略（自動從 VERCEL_GIT_REPO_OWNER + VERCEL_GIT_REPO_SLUG 推導）
# - Firebase App Hosting：必填（平台不提供 VERCEL_GIT_REPO_* 變數）
MODULE_MARKET_GITHUB_REPO=
# 模組套件簽章信任根（選填）：JSON，moduleId -> base64 SPKI 公鑰或公鑰陣列
# 官方 E／F／G 的公鑰已內建；此變數用來追加其他作者或自架市集的公鑰。
# 例：{"myModule":["MCowBQYDK2VwAyEA..."]}
MODULE_MARKET_TRUSTED_KEYS=
# 設為 1 時，正式安裝會拒絕未簽章套件（預設空＝兼容既有未簽章套件）
MODULE_MARKET_REQUIRE_SIGNATURE=
# 模組安裝／卸載的指定管理員（選填，逗號分隔 uid 或 email，不分大小寫）
# 未設定＝所有具「功能模組管理」權限的管理員皆可安裝／卸載。
# 安裝／卸載會建立 GitHub 提交（production），高風險環境建議限縮。
# 例：MODULE_MARKET_INSTALL_ADMINS=uid1,admin@school.edu
MODULE_MARKET_INSTALL_ADMINS=

# 模組沙箱（選填，逗號分隔模組代碼）
# 啟用前先執行：npm run module:sandbox-build -- --module <value>
# 未設定＝模組走原本的 in-process 流程。
# 例：MODULE_SANDBOX_MODULES=examRegistration
MODULE_SANDBOX_MODULES=
# 沙箱模組允許連線的外部網域（逗號分隔；未設定＝全部拒絕）
# 例：MODULE_SANDBOX_ALLOWED_HOSTS=api.canva.com
MODULE_SANDBOX_ALLOWED_HOSTS=

# 主題市集（可全省略：已內建預設市集，fork 後零設定即可使用）
# 僅「要指向自己市集」的部署才需覆寫；只接受 https（開發環境可用 http://localhost）
# 預設：https://raw.githubusercontent.com/takan003/campus-toolkit-theme-marketplace/main/index.json
THEME_MARKET_URL=
THEME_MARKET_INDEX_URL=

# 主題市集發佈／投稿橋樑（M2.5／§21）：GitHub 服務帳號 token
# 建立：GitHub → Settings → Developer settings → Fine-grained token
# 權限只給單一 repo（takan003/campus-toolkit-theme-marketplace）的 Contents: Read and write
# 與 Pull requests: Read and write；未設定時發佈與投稿功能停用（讀取與安裝不受影響）
THEME_MARKET_GITHUB_TOKEN=
# 市集 repo（可省略，預設如下）
THEME_MARKET_GITHUB_REPO=takan003/campus-toolkit-theme-marketplace

# 統計儀表板（/admin/stats，僅超級管理員）：Vercel 用量來源（僅 Vercel 部署適用，可全省略）
# 建立方式：帳號設定的「齒輪」圖示（畫面右上角帳號選單 → Settings，帳號層級，
# 不是全站設定、也不是專案的 Settings）→ 左側 Tokens → Create Token（Scope 選 Full Account，
# 用量屬帳號／團隊層級，單一專案 scope 讀不到）；未設定時儀表板只顯示設定指引
VERCEL_TOKEN=
# 團隊專案的 teamId（團隊首頁網址 team_xxx 開頭）；可留空，
# 首查失敗時程式會自動以 /v2/user 與 /v2/teams 探索帳號底下的團隊逐個重試
VERCEL_TEAM_ID=
# 對照的免費額度表：hobby（預設）或 pro（方案以 Vercel 帳號為準）
VERCEL_PLAN=hobby
# 備註：Firestore 用量走 Cloud Monitoring，服務帳號需 roles/monitoring.viewer
# （頁面會顯示指引：gcloud 指令，或 Google Cloud Console → IAM → 搜尋 Monitoring Viewer）
