# Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Session (至少 32 字元隨機字串，可用 openssl rand -base64 32 產生)
# 注意：若曾在本機明文 .env 中存在過，視為已暴露，請輪換並同步更新 Vercel
SESSION_SECRET=your_session_secret_min_32_chars

# 僅在「可信反向代理／平台會覆寫 forwarding header」時設 true（如 Vercel 為自動 VERCEL=1）。
# 直接 next start 暴露時請維持不設：此時 x-real-ip / x-forwarded-for 可被客戶端偽造，程式不會採信。
# TRUST_PROXY=true

# 初始管理員建立開關：僅首次建管時設 true，建完請移除或設 false
ALLOW_BOOTSTRAP_ADMIN=false

# Firebase Admin SDK 服務帳號金鑰（Firebase Console → 專案設定 → 服務帳號 → 產生新的私鑰，整段 JSON 字串）
# 安全提醒：
# 1) 勿將實際金鑰提交進 git；機密請存於 Vercel Environment Variables
# 2) 若私鑰曾在任何可分享路徑以明文存在過，請到 Firebase Console 輪換（產生新私鑰並刪除舊私鑰）
FIREBASE_SERVICE_ACCOUNT_KEY=

# SMTP 寄信（忘記密碼信件）；未設定時忘記密碼功能會回 503
#
# 【學校 Google Workspace 專用信箱設定步驟】
# 1) 請管理員建立專用信箱（如 noreply@school.edu.tw）並指派 Gmail 授權
#    ※ 群組／通訊群組信箱無法用 SMTP 登入，必須是有 Gmail 的使用者帳號
# 2) 以該信箱登入 myaccount.google.com → 安全性 → 兩步驟驗證 → 開啟
# 3) 開啟兩步驟驗證後到 myaccount.google.com/apppasswords 建立「應用程式密碼」（16 碼）
#    ※ 若該頁面不存在，代表管理員封鎖了應用程式密碼，需改用 OAuth2 或校內 SMTP relay
# 4) 應用程式密碼填入 SMTP_PASS（不可用一般登入密碼：Google 已於 2025/03 停用基本驗證）
# 5) 實際值請填在 .env.local（本機）或 Vercel Environment Variables，切勿寫進本檔
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 寄件者顯示名稱與寄件地址；寄件地址須為 SMTP_USER 本身或其別名
# 例：數位校園工具箱 <noreply@school.edu.tw>
SMTP_FROM=

# 站台對外網址（產生信件中的重設連結用）
# 正式環境務必設定：未設定時改用請求來源，Host 遭偽造可能使連結指向攻擊者網域
APP_BASE_URL=
